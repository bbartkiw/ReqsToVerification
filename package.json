{
  "name": "reqs-to-verification",
  "version": "0.1.0",
  "description": "Import requirements, build verification test cases and test plans (V-model, verification side)",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/main --out-extension:.js=.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "docx": "9.16.0",
    "exceljs": "4.4.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
